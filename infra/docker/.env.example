# MyMA node bootstrap environment
# Copy this file to .env in the same directory and replace all placeholder values.
# It is pre-approved for commit because it contains no real secrets.

# Public FQDN of this VPS node. Used for the agent's Traefik router and the
# Let's Encrypt certificate request.
MYMA_NODE_FQDN=node-1.example.myma.id

# Email address passed to Let's Encrypt for expiration notices.
ACME_EMAIL=admin@example.com

# MariaDB root password for the shared MariaDB container on this node.
# The agent uses this account to create/delete per-instance databases and users.
MARIADB_ROOT_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_64_CHARS

# HMAC signing key shared between the Cloudflare Worker and this agent.
# Generate with: openssl rand -base64 32
AGENT_KEY=REPLACE_WITH_AGENT_SIGNING_KEY

# Key id that must appear in the X-Myma-Key-Id request header.
AGENT_KEY_ID=myma-agent-key-1
