# MyMA VPS Agent environment variables
# Copy to .env and fill with real values. Never commit .env.

# HMAC auth — must match the values configured in the Cloudflare Worker.
AGENT_KEY_ID=myma-agent-key-1
AGENT_KEY=replace-with-a-cryptographically-random-secret-min-32-bytes

# Agent HTTP listen port (inside the container this is always 3000).
MYMA_AGENT_PORT=3000

# Per-instance working directory.
MYMA_INSTANCES_DIR=/opt/myma/instances

# Path to the canonical infra/moodle/compose.template.yml; copied to the node
# by bootstrap-node.sh.
MYMA_COMPOSE_TEMPLATE=/opt/myma/infra/moodle/compose.template.yml

# Shared MariaDB admin credentials used to create per-instance DBs/users.
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_ROOT_USER=root
MARIADB_ROOT_PASSWORD=replace-with-the-shared-mariadb-admin-password

# Shared Redis connection.
REDIS_HOST=redis
REDIS_PORT=6379
